# Example file — GENERATED from EnvVar::ALL, do not edit by hand.
# Regenerate with: cargo run -p dnqatv-cli --bin dnqatv -- config example
# Copy to .env and fill in the required keys.

# PostgreSQL connection string. Must end with a database name.
# REQUIRED
DATABASE_URL=

# Maximum number of connections in the pool.
# DATABASE_MAX_CONNECTIONS=16

# Number of connections kept warm.
# DATABASE_MIN_CONNECTIONS=1

# How long to wait for a new connection to open.
# DATABASE_CONNECT_TIMEOUT_SECS=8

# How long to wait to borrow a connection from the pool.
# DATABASE_ACQUIRE_TIMEOUT_SECS=8

# Close a connection after it has been idle this long.
# DATABASE_IDLE_TIMEOUT_SECS=300

# Log every SQL statement: true or false.
# DATABASE_SQL_LOGGING=false

# Runtime environment: development or production.
# APP_ENV=development

# Address the web server listens on.
# HTTP_ADDR=127.0.0.1:8080

# Directory holding the rendered page images.
# PAGE_IMAGE_DIR=frontend/static/trang
